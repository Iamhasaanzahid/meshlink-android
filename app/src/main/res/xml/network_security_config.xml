<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Nothing on the public internet may use plain HTTP. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Only the developer's local machines may use plain HTTP. These are the
         emulator host, localhost and the optional local Ollama AI engine. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.50</domain>
    </domain-config>
</network-security-config>
